generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model attachments {
  id         Int      @id @default(autoincrement())
  file_name  String   @db.VarChar(255)
  file_url   String
  task_id    Int
  created_at DateTime @default(now()) @db.Timestamp(6)
  /// processing | ready | failed (migrations/011_add_status_to_attachments.sql)
  status     String   @default("processing") @db.VarChar(20)
  tasks      tasks    @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model comments {
  id         Int      @id @default(autoincrement())
  content    String
  task_id    Int
  created_at DateTime @default(now()) @db.Timestamp(6)
  created_by Int?
  users      users?   @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  tasks      tasks    @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id], map: "idx_comments_task_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model project_members {
  user_id    Int
  project_id Int
  role       String   @db.VarChar(20)
  projects   projects @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, project_id])
}

model projects {
  id              Int               @id @default(autoincrement())
  title           String            @db.VarChar(100)
  description     String?
  owner_id        Int
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  project_members project_members[]
  users           users             @relation(fields: [owner_id], references: [id], onUpdate: NoAction)
  tasks           tasks[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tasks {
  id          Int           @id @default(autoincrement())
  title       String        @db.VarChar(100)
  description String?
  status      String        @db.VarChar(20)
  project_id  Int
  created_at  DateTime      @default(now()) @db.Timestamp(6)
  created_by  Int?
  attachments attachments[]
  comments    comments[]
  users       users?        @relation(fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)
  projects    projects      @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([project_id], map: "idx_tasks_project_id")
  @@index([status], map: "idx_tasks_status")
}

model users {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  email           String            @unique @db.VarChar(255)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  password_hash   String?           @db.VarChar(255)
  comments        comments[]
  project_members project_members[]
  projects        projects[]
  tasks           tasks[]
}
